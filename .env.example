# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.

# --- X (Twitter) API v2 -------------------------------------------------
# Only the bearer token is used by the app. Get one from
# https://developer.x.com (Developer Portal -> your app -> Keys and tokens).
# Email and Instagram detection work fine without these.
FAKEPROFILE_BEARER_TOKEN=
FAKEPROFILE_API_KEY=
FAKEPROFILE_API_SECRET_KEY=
FAKEPROFILE_ACCESS_TOKEN=
FAKEPROFILE_ACCESS_TOKEN_SECRET=

# --- Django (optional for local development) ----------------------------
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
